{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.backup",
    "watchPatterns": ["backup/**", "Dockerfile.backup"]
  },
  "deploy": {
    "cronSchedule": "0 4 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
