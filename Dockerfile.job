# ═══════════════════════════════════════════════════════════════════════════
# IMAGEM DO JOB EM BATCH DO DESAFIO DO DIA (RF-DES-011a) — T018.
#
# São DUAS imagens neste repositório, de propósito:
#
#   Dockerfile      → a API. Serve HTTP, fica de pé, tem healthcheck.
#   Dockerfile.job  → ESTA. Acorda pelo cron, gera e mede os candidatos do
#                     Desafio do Dia, GRAVA no Postgres e TERMINA.
#
# ⚠️ "Terminar é sucesso." Não há porta, não há rota e não há `healthcheckPath`;
#    a política de reinício do serviço é `NEVER` (ver `railway.job.json`). Um
#    container que sai com código 0 aqui fez exatamente o que devia.
#
# ⚠️ A API nunca chama o job e o job nunca chama a API. Os dois se falam pelo
#    **Postgres**, que já é a fronteira entre eles. O preço aceito por essa
#    separação são duas imagens Docker a manter — e está dito em voz alta na
#    spec (RF-DES-011a) porque é custo real, não detalhe.
#
# Por que o job não mora dentro da API, em ordem de peso:
#   (a) medir dezenas de candidatos × 20 execuções × 4 níveis disputaria CPU
#       com quem serve o aplicativo, deixando-o lento sem que nada denuncie;
#   (b) uma queda do job por memória levaria a API junto;
#   (c) o runtime de inferência entraria na imagem da API sem que ela o use.
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# ESTÁGIO 1 de 2 — O MOTOR DO APARELHO, COMPILADO PARA DENTRO DA IMAGEM
# ═══════════════════════════════════════════════════════════════════════════
#
# ⛔ **Desde 25/09/2026 o job não joga mais com o port Python.** Quem escolhe os
# lances do gabarito e da régua é o **motor Dart**, byte-idêntico ao que o
# aplicativo embarca — porque o gabarito precisa ser o que a CPU vai jogar no
# aparelho de quem resolve. O diagnóstico inteiro está em
# `docs/investigacao_paridade_motores.md`.
#
# ⚠️ **E ele é compilado AQUI, e não trazido pronto.** O binário da máquina do
# dono é um `.exe` de Windows; esta imagem é `linux/amd64`. Compilar no build é o
# único jeito de o job ter com que jogar na nuvem, e não custa nada de confiança:
#
# ⛔ **A trava de identidade não afrouxa.** Quem compila é
# `bin/compilar_servidor_de_lances.dart`, o mesmo programa que roda na máquina do
# dono, e ele carimba dentro do binário o SHA-256 dos dezesseis arquivos de
# `lib/`. Na abertura do processo, `motores/damas/jogador_dart.py` recalcula o
# mesmo resumo a partir dos fontes espelhados e **recusa a conversa** se
# divergirem. Um build que produzisse um motor diferente falharia alto no
# primeiro lance, e não geraria uma fila inteira de desafios errados.
#
# ⚠️ **Multi-stage de propósito:** o SDK do Dart pesa ~700 MB e ⛔ não vai para a
# imagem final. O que atravessa é um executável autocontido de alguns megabytes.
FROM dart:stable AS motor

WORKDIR /motor

# Só o pacote do motor, que veio no espelho: `pubspec.yaml`, `lib/` e `bin/`.
#
# ⚠️ **O `pubspec.lock` ⛔ chega aqui**, e isso é decisão, não sorte: ele está no
# `.dockerignore` (e no `.gitignore`). Basta abrir a pasta do espelho num editor
# com o analisador do Dart para ele rodar `pub get` sozinho e deixar um lock
# resolvido no **Windows** para trás; o que este build precisa é de um `pub get`
# resolvido nesta imagem. Um lock viajando daqui faria o build falhar por um
# motivo que não tem nada a ver com damas.
COPY espelho_laboratorio/jogos/jogo_damas/motor_dart/ ./

# `crypto` e `lints` são `dev_dependencies` — são elas que o carimbo usa.
RUN dart pub get

# ⚠️ Este comando faz as DUAS coisas, e nessa ordem: grava
# `bin/_resumo_do_motor.g.dart` com o SHA-256 de cada arquivo de `lib/`, e então
# compila. Rodar `dart compile` direto pularia o carimbo, e o executável abriria
# a conversa afirmando um resumo velho.
RUN dart run bin/compilar_servidor_de_lances.dart


# ═══════════════════════════════════════════════════════════════════════════
# ESTÁGIO 2 de 2 — O JOB
# ═══════════════════════════════════════════════════════════════════════════

# A MESMA base da API. Não é coincidência nem gosto: o `ai-edge-litert` publica
# wheel para `cp311` em `linux/amd64`, e é a dependência mais estreita do
# conjunto — quem manda na versão do Python é ela (`research.md` §R-03).
FROM python:3.11-slim

WORKDIR /app

# ── 0. O log tem de sair ENQUANTO o job roda ─────────────────────────────────
# ⚠️ Fora de um terminal, o Python usa buffer de bloco no `stdout`: os `print()`
#    ficam presos até encher ~8 KB ou até o processo terminar. Numa API isso
#    passa despercebido — as respostas são curtas e frequentes. ⛔ **Aqui não**:
#    a execução cobre 7 dias, leva dezenas de minutos, e o painel do Railway
#    mostraria a tela vazia o tempo todo, indistinguível de um job pendurado.
#
# ⚠️ E o pior seria a assimetria: `stderr` é de linha mesmo sem terminal, então
#    os `⛔` de erro apareceriam **na hora** e os `[job]` de sucesso só no fim —
#    um log em que só as más notícias chegam ao vivo.
ENV PYTHONUNBUFFERED=1

# ── 1. Dependências ──────────────────────────────────────────────────────────
# Copiar SÓ o `requirements` antes do código faz o Docker reaproveitar esta
# camada enquanto a lista não mudar: alterar uma linha de Python não reinstala
# o LiteRT inteiro.
COPY requirements_job.txt .
RUN pip install --no-cache-dir -r requirements_job.txt

# ── 2. O código, o espelho e o modelo ────────────────────────────────────────
# Entra tudo o que o `.dockerignore` não barrou: `motores/`, `job/`, `api/`
# (o job importa os *models* de banco de lá), `scripts/` e — o item pesado —
# `espelho_laboratorio/`, que carrega a `.tflite` de 19,8 MB.
# ⚠️ O que não estiver aqui dentro NÃO EXISTE na nuvem (RF-DES-148): o Railway
#    constrói a imagem a partir deste repositório e de mais nada.
COPY . .

# ── 2b. O MOTOR compilado no estágio 1 ───────────────────────────────────────
#
# ⚠️ O binário vai para `/usr/local/bin/`, fora do `/app` — então ele ⛔ disputa
# lugar com nada do repositório, e a ordem em relação ao `COPY . .` é indiferente.
# Fica aqui por leitura: o motor e a variável que o aponta, juntos.
#
# `MOTOR_DART_DAMAS` é a variável que `motores/damas/jogador_dart.py` consulta
# primeiro. ⛔ Sem ela, ele procuraria o laboratório vizinho — que só existe na
# máquina do dono — e falharia com uma mensagem sobre compilar, dentro de uma
# imagem onde compilar já foi feito.
COPY --from=motor /motor/bin/servidor_de_lances_damas /usr/local/bin/servidor_de_lances_damas
ENV MOTOR_DART_DAMAS=/usr/local/bin/servidor_de_lances_damas

# ── 3. O PORTÃO DE BUILD (T001) ──────────────────────────────────────────────
# ⚠️ ESTA LINHA É A ÚNICA EXECUÇÃO EM `linux/amd64` QUE O PROJETO TEM.
#
# O script monta 12 tensores determinísticos, roda a inferência com o
# `ai-edge-litert` desta imagem e compara, número por número, com
# `scripts/referencia_runtime_inferencia.json` — arquivo gerado pelo
# `tensorflow.lite` que o `tflite_flutter` do aplicativo embrulha.
#
# `RUN` falhando **derruba o build**, e é esse o objetivo: uma imagem que
# calcula diferente do aplicativo nunca chega ao Railway.
#
# ⚠️ O risco que ele fecha NÃO é "não instalou" — isso falharia alto e cedo. É
#    instalar, abrir o modelo e devolver números *um pouco* diferentes: a
#    calibração do desafio sairia de um adversário que não é o adversário que a
#    pessoa enfrenta (RF-DES-018b), e nada no sistema denunciaria.
#
# ⚠️ E por que portão, e não um comando que alguém roda: comando avulso se roda
#    uma vez e envelhece. O portão re-confere a cada imagem construída —
#    inclusive no dia em que alguém subir a versão do `ai-edge-litert` sem
#    pensar. A máquina do dono não tem Docker nem WSL (conferido em 09/09/2026),
#    então esta é a única oportunidade que existe de conferir no alvo real.
RUN python scripts/conferir_runtime_inferencia.py --runtime litert

# ── 3b. O PORTÃO DO MOTOR DE DAMAS (25/09/2026) ──────────────────────────────
#
# O irmão do portão acima, e pela mesma razão: o de cima pergunta *"esta imagem
# calcula igual ao aplicativo?"* sobre a CNN do Pontinhos; este pergunta o mesmo
# sobre o motor de damas — que nesta imagem foi **compilado aqui**, no estágio 1.
#
# ⛔ Ele confere a trava de identidade, a base de finais das quatro modalidades e
# **três lances de uma partida real**, com nós, profundidade e consultas à base.
# Um lance igual com nós diferentes já reprova: dois motores que param em pontos
# diferentes só escolhem o mesmo lance por sorte.
#
# ⚠️ O risco que ele fecha não é "não compilou" — isso falharia cedo e alto. É
# compilar, abrir e jogar **um pouco** diferente: o gabarito sairia de um
# adversário que não é o adversário da pessoa, e nada no dado denunciaria. Foi
# exatamente esse o defeito de 25/09/2026.
RUN python scripts/conferir_motor_dart.py

# ── 4. Usuário sem privilégios ───────────────────────────────────────────────
# Defesa em profundidade (MEL-01), a mesma do `Dockerfile` da API: se um dia
# houver execução remota de código numa dependência, o atacante não cai como
# root dentro do container.
RUN adduser --disabled-password --gecos "" appjob && chown -R appjob /app
USER appjob

# ── 5. O que ele faz ao acordar ──────────────────────────────────────────────
# Forma "exec" (lista, sem `sh -c`): o processo do Python vira o PID 1 e recebe
# o SIGTERM do Railway diretamente, sem um shell no meio engolindo o sinal.
# ⚠️ Sem `$PORT`, sem `--host`, sem `--port`: o job não escuta nada.
CMD ["python", "-m", "job"]
