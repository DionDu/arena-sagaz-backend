{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m api.notificacoes.disparo_de_reacoes",
    "cronSchedule": "0 * * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
